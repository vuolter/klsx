{
  "name": "klsx",
  "version": "0.4.0",
  "description": "Same as clsx but \"maybe\" better",
  "keywords": [
    "bun",
    "class",
    "classix",
    "classname",
    "classnames",
    "clsx",
    "cn",
    "cx",
    "klsx",
    "kx"
  ],
  "license": "MIT",
  "author": {
    "name": "Walter Purcaro",
    "url": "https://github.com/vuolter"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vuolter/klsx.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun typecheck && tsdown",
    "typecheck": "tsc --build --noEmit",
    "format": "oxfmt --write .",
    "lint": "oxlint --fix .",
    "bench": "bun run build && bun ./tests/bench",
    "postinstall": "npm install --force --ignore-scripts --package-lock-only --silent"
  },
  "devDependencies": {
    "@socketsecurity/bun-security-scanner": "1.1.3",
    "@types/bun": "1.4.4",
    "classix": "2.2.27",
    "classnames": "2.5.1",
    "clsx": "2.1.1",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "tinybench": "6.2.3",
    "tsdown": "0.23.4",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
